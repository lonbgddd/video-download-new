APP_URL=http://localhost:3000
MAX_MEDIA_DURATION=3600
MAX_FILE_SIZE=1073741824
MAX_CONCURRENT_JOBS=3
DOWNLOAD_TIMEOUT=600000
JOB_TTL=1800
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=20
ADS_ENABLED=true
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=VideoDownloader
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=privacy@findtoolpdf.online
NEXT_PUBLIC_LEGAL_POSTAL_ADDRESS=Vietnam

# Monetag Vignette — loaded when the download dialog opens.
# Paste a replacement Zone ID / script URL from Monetag here when rotating zones.
NEXT_PUBLIC_MONETAG_VIGNETTE_ZONE_ID=12238810
NEXT_PUBLIC_MONETAG_VIGNETTE_SCRIPT_URL=https://n6wxm.com/vignette.min.js

# Monetag In-Page Push — loaded globally with next/script afterInteractive.
NEXT_PUBLIC_MONETAG_IN_PAGE_PUSH_ZONE_ID=12238840
NEXT_PUBLIC_MONETAG_IN_PAGE_PUSH_SCRIPT_URL=https://nap5k.com/tag.min.js

# Adcash Interstitial — triggered by Analyze and Download user actions.
# Paste the replacement public Adcash Interstitial Zone ID here.
NEXT_PUBLIC_ADCASH_INTERSTITIAL_ZONE_ID=12435318

# Adsterra/Native banner placements. Each placement must use its own script URL
# and container ID; these values reserve Header, desktop rail and form slots.
NEXT_PUBLIC_ADSTERRA_HEADER_SCRIPT_URL=
NEXT_PUBLIC_ADSTERRA_HEADER_CONTAINER_ID=
NEXT_PUBLIC_ADSTERRA_LEFT_RAIL_SCRIPT_URL=
NEXT_PUBLIC_ADSTERRA_LEFT_RAIL_CONTAINER_ID=
NEXT_PUBLIC_ADSTERRA_RIGHT_RAIL_SCRIPT_URL=
NEXT_PUBLIC_ADSTERRA_RIGHT_RAIL_CONTAINER_ID=
NEXT_PUBLIC_ADSTERRA_INPUT_SCRIPT_URL=
NEXT_PUBLIC_ADSTERRA_INPUT_CONTAINER_ID=
NEXT_PUBLIC_ADSTERRA_DOWNLOAD_MODAL_SCRIPT_URL=
NEXT_PUBLIC_ADSTERRA_DOWNLOAD_MODAL_CONTAINER_ID=
YT_DLP_PATH=yt-dlp
# Required for HLS → MP4. Docker includes FFmpeg; macOS: brew install ffmpeg.
# Conversion uses MAX_FILE_SIZE, MAX_CONCURRENT_JOBS and DOWNLOAD_TIMEOUT above.
FFMPEG_PATH=ffmpeg
TEMP_DIRECTORY=/tmp/video-downloader
FFPROBE_PATH=ffprobe
