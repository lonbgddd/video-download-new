FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG ADS_ENABLED=true
ENV ADS_ENABLED=$ADS_ENABLED
ARG NEXT_PUBLIC_LEGAL_OPERATOR_NAME=VideoDownloader
ARG NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=privacy@findtoolpdf.online
ARG NEXT_PUBLIC_LEGAL_POSTAL_ADDRESS=Vietnam
ARG NEXT_PUBLIC_MONETAG_VIGNETTE_ZONE_ID=12238810
ARG NEXT_PUBLIC_MONETAG_VIGNETTE_SCRIPT_URL=https://n6wxm.com/vignette.min.js
ARG NEXT_PUBLIC_MONETAG_IN_PAGE_PUSH_ZONE_ID=12238840
ARG NEXT_PUBLIC_MONETAG_IN_PAGE_PUSH_SCRIPT_URL=https://nap5k.com/tag.min.js
ARG NEXT_PUBLIC_ADCASH_INTERSTITIAL_ZONE_ID=12435318
ARG NEXT_PUBLIC_ADSTERRA_HEADER_SCRIPT_URL
ARG NEXT_PUBLIC_ADSTERRA_HEADER_CONTAINER_ID
ARG NEXT_PUBLIC_ADSTERRA_LEFT_RAIL_SCRIPT_URL
ARG NEXT_PUBLIC_ADSTERRA_LEFT_RAIL_CONTAINER_ID
ARG NEXT_PUBLIC_ADSTERRA_RIGHT_RAIL_SCRIPT_URL
ARG NEXT_PUBLIC_ADSTERRA_RIGHT_RAIL_CONTAINER_ID
ARG NEXT_PUBLIC_ADSTERRA_INPUT_SCRIPT_URL
ARG NEXT_PUBLIC_ADSTERRA_INPUT_CONTAINER_ID
ARG NEXT_PUBLIC_ADSTERRA_DOWNLOAD_MODAL_SCRIPT_URL
ARG NEXT_PUBLIC_ADSTERRA_DOWNLOAD_MODAL_CONTAINER_ID
ENV NEXT_PUBLIC_LEGAL_OPERATOR_NAME=$NEXT_PUBLIC_LEGAL_OPERATOR_NAME
ENV NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=$NEXT_PUBLIC_LEGAL_CONTACT_EMAIL
ENV NEXT_PUBLIC_LEGAL_POSTAL_ADDRESS=$NEXT_PUBLIC_LEGAL_POSTAL_ADDRESS
ENV NEXT_PUBLIC_MONETAG_VIGNETTE_ZONE_ID=$NEXT_PUBLIC_MONETAG_VIGNETTE_ZONE_ID
ENV NEXT_PUBLIC_MONETAG_VIGNETTE_SCRIPT_URL=$NEXT_PUBLIC_MONETAG_VIGNETTE_SCRIPT_URL
ENV NEXT_PUBLIC_MONETAG_IN_PAGE_PUSH_ZONE_ID=$NEXT_PUBLIC_MONETAG_IN_PAGE_PUSH_ZONE_ID
ENV NEXT_PUBLIC_MONETAG_IN_PAGE_PUSH_SCRIPT_URL=$NEXT_PUBLIC_MONETAG_IN_PAGE_PUSH_SCRIPT_URL
ENV NEXT_PUBLIC_ADCASH_INTERSTITIAL_ZONE_ID=$NEXT_PUBLIC_ADCASH_INTERSTITIAL_ZONE_ID
ENV NEXT_PUBLIC_ADSTERRA_HEADER_SCRIPT_URL=$NEXT_PUBLIC_ADSTERRA_HEADER_SCRIPT_URL
ENV NEXT_PUBLIC_ADSTERRA_HEADER_CONTAINER_ID=$NEXT_PUBLIC_ADSTERRA_HEADER_CONTAINER_ID
ENV NEXT_PUBLIC_ADSTERRA_LEFT_RAIL_SCRIPT_URL=$NEXT_PUBLIC_ADSTERRA_LEFT_RAIL_SCRIPT_URL
ENV NEXT_PUBLIC_ADSTERRA_LEFT_RAIL_CONTAINER_ID=$NEXT_PUBLIC_ADSTERRA_LEFT_RAIL_CONTAINER_ID
ENV NEXT_PUBLIC_ADSTERRA_RIGHT_RAIL_SCRIPT_URL=$NEXT_PUBLIC_ADSTERRA_RIGHT_RAIL_SCRIPT_URL
ENV NEXT_PUBLIC_ADSTERRA_RIGHT_RAIL_CONTAINER_ID=$NEXT_PUBLIC_ADSTERRA_RIGHT_RAIL_CONTAINER_ID
ENV NEXT_PUBLIC_ADSTERRA_INPUT_SCRIPT_URL=$NEXT_PUBLIC_ADSTERRA_INPUT_SCRIPT_URL
ENV NEXT_PUBLIC_ADSTERRA_INPUT_CONTAINER_ID=$NEXT_PUBLIC_ADSTERRA_INPUT_CONTAINER_ID
ENV NEXT_PUBLIC_ADSTERRA_DOWNLOAD_MODAL_SCRIPT_URL=$NEXT_PUBLIC_ADSTERRA_DOWNLOAD_MODAL_SCRIPT_URL
ENV NEXT_PUBLIC_ADSTERRA_DOWNLOAD_MODAL_CONTAINER_ID=$NEXT_PUBLIC_ADSTERRA_DOWNLOAD_MODAL_CONTAINER_ID
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache ffmpeg python3 py3-pip \
  && pip3 install --no-cache-dir --break-system-packages "yt-dlp[default]" \
  && addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs \
  && mkdir -p /tmp/video-downloader \
  && chown nextjs:nodejs /tmp/video-downloader
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
